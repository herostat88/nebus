# Optional: docker compose starts with local-only development defaults without this file.
# Deployment secrets and all runtime tuning can be overridden via .env/environment.
API_KEY=replace-with-at-least-16-characters
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
POSTGRES_USER=payments
POSTGRES_PASSWORD=replace-this-db-password
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=replace-this-broker-password
API_PORT=8010
WEBHOOK_PORT=8011
RABBITMQ_MANAGEMENT_PORT=15673
WEBHOOK_ALLOWED_HOSTS=webhook
WEBHOOK_ALLOWED_PORTS=80,443,8080
WEBHOOK_TIMEOUT=5
WEBHOOK_MAX_RESPONSE_BYTES=65536
GATEWAY_DELAY_MIN=2
GATEWAY_DELAY_MAX=5
GATEWAY_SUCCESS_RATE=0.9
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=1
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=20
PUBLISH_TIMEOUT=5
OUTBOX_RETRY_MAX_SECONDS=60
INFRA_RETRY_DELAY=1
RABBITMQ_PREFIX=payments
BROKER_HEARTBEAT=30
BROKER_DELIVERY_LIMIT=1000
BROKER_QUEUE_MAX_LENGTH=10000
SHUTDOWN_TIMEOUT=15
CONSUMER_STOP_GRACE_PERIOD=35s
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
LOG_LEVEL=INFO
